# ---------------------------------------------------------------------------
# Asber — configuration
#
# Copy to .env:  cp .env.example .env
# EVERY value below is optional. With an empty .env the dashboard still runs
# and collects from all public sources that do not require authentication.
# ---------------------------------------------------------------------------

# --- Database / cache (defaults match docker-compose.yml) -------------------
POSTGRES_USER=asber
# Fine for a local stack that listens on 127.0.0.1 only. For the deployed
# stack (docker-compose.prod.yml) this MUST be replaced — generate one with:
#   openssl rand -base64 32
POSTGRES_PASSWORD=asber
POSTGRES_DB=asber
# Set only when running the backend outside Docker:
# DATABASE_URL=postgresql+psycopg://asber:asber@localhost:5432/asber
# REDIS_URL=redis://localhost:6379/0

# --- Optional API keys ------------------------------------------------------
# NVD: works without a key (5 requests/30s). A free key raises it to 50/30s.
# Request one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# GitHub: without a token the search API allows 10 requests/min; a classic
# token with NO scopes (public data only) raises it to 30/min.
GITHUB_TOKEN=

# Phase 2 sources. Absent keys simply keep those sources disabled.
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
ABUSECH_AUTH_KEY=

# --- Ingestion tuning -------------------------------------------------------
# How far back to reach on the very first NVD sync (days).
NVD_INITIAL_DAYS=14
# Keep newly published CVEs for this many days of publication history.
NVD_TRACK_DAYS=120
# CVEs enriched from NVD per run (KEV / high-relevance first).
NVD_ENRICH_PER_RUN=25
# Days before a cached NVD record is refreshed.
NVD_CACHE_DAYS=7

# GitHub: how many prioritised CVEs to search per run, and how often to recheck.
GITHUB_MAX_CVES_PER_RUN=15
GITHUB_RECHECK_HOURS=24
# Extra searches, ';'-separated. Example:
# GITHUB_EXTRA_QUERIES=sigma rules windows in:name;"CVE-2026" exploit in:name
GITHUB_EXTRA_QUERIES=
# Repositories to watch for releases, comma-separated owner/repo. Example:
# GITHUB_WATCH_REPOS=SigmaHQ/sigma,VirusTotal/yara,projectdiscovery/nuclei-templates
GITHUB_WATCH_REPOS=

# Force sources on/off regardless of their default (comma-separated keys).
# Example: enable Phase 2 feeds that need no key:
# SOURCES_ENABLED=msrc,mandiant,sentinellabs,crowdstrike,qualys,project_zero
SOURCES_ENABLED=
SOURCES_DISABLED=

# Per-source interval override in seconds (minimum 300).
# SOURCE_INTERVAL_CISA_KEV=900
# SOURCE_INTERVAL_NVD=1800
# SOURCE_INTERVAL_MITRE_ATTACK=21600

# Run every enabled source once when the scheduler starts.
RUN_ON_STARTUP=true

# --- HTTP behaviour ---------------------------------------------------------
# Identify yourself politely to the sources you poll.
HTTP_USER_AGENT=Asber/0.1 (personal threat-intelligence dashboard; local use)
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=4

# --- Safety -----------------------------------------------------------------
# Downloading malware samples is NOT implemented and must stay false.
MALWARE_DOWNLOAD_ENABLED=false

# --- Optional AI layer (Phase 3) -------------------------------------------
# Set to the LLM provider you want to use. When enabled, every generated
# summary must cite the sources Asber collected; nothing may be invented.
AI_PROVIDER=none
# AI_API_KEY=

# --- API --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=240
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Deployment (docker-compose.prod.yml only — not needed for local use)
# ---------------------------------------------------------------------------

# The hostname Caddy issues a TLS certificate for. Must already point at this
# server, or the certificate request fails.
ASBER_DOMAIN=asber.example.com

# --- Authentication ---------------------------------------------------------
# Signing key for the session cookie. Generate with:  openssl rand -base64 32
AUTH_SECRET=

# WHO MAY SIGN IN. Comma-separated e-mail addresses.
# OAuth proves identity, it does not grant access: without this list every
# Google/GitHub account on the internet would be a valid login. An EMPTY list
# therefore denies everyone rather than failing open.
AUTH_ALLOWED_EMAILS=

# Who may additionally trigger ingestion runs (POST /api/sources/{key}/run).
# Defaults to AUTH_ALLOWED_EMAILS when empty.
AUTH_ADMIN_EMAILS=

# Configure at least one provider; only the configured ones appear on /login.
# Google:  https://console.cloud.google.com/apis/credentials
#          redirect URI  https://<ASBER_DOMAIN>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub:  https://github.com/settings/developers  (OAuth App)
#          callback URL  https://<ASBER_DOMAIN>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Proxy ------------------------------------------------------------------
# Networks whose X-Forwarded-For header is believed (CIDR, comma separated).
# Anything outside this list is rate limited by its real peer address, so a
# forged header cannot buy an attacker extra request budget. The default covers
# the Docker bridge, which is where Caddy runs.
TRUSTED_PROXY_IPS=172.16.0.0/12
